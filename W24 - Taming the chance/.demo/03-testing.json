{
  "$schema": "https://demotime.show/demo-time.schema.json",
  "title": "Taming the chance – Testing",
  "description": "A comprehensive walkthrough of building a testing scenario for Power Apps using Playwright, TypeScript and some AI assist",
  "version": 3,
  "scenes": [
    {
      "id": "scene-mqa5ovl3-15jj",
      "title": "3.1 - Init: Copy the tests",
      "moves": [
        {
          "action": "executeTerminalCommand",
          "command": "cp -r .demo/file-contents/Setup/tests/canvas {TEST_SETUP_FOLDER_NAME}/tests"
        },
        {
          "action": "executeTerminalCommand",
          "command": "cp -r .demo/file-contents/Setup/tests/mda {TEST_SETUP_FOLDER_NAME}/tests",
          "autoExecute": true
        },
        {
          "action": "executeTerminalCommand",
          "command": "cp -r .demo/file-contents/Setup/tests/pac {TEST_SETUP_FOLDER_NAME}/tests",
          "autoExecute": true
        }
      ]
    },
    {
      "id": "scene-mpsfxts4-0pc2",
      "title": "3.2 - Test: PAC app",
      "moves": [
        {
          "action": "executeTerminalCommand",
          "command": "cd {TEST_SETUP_FOLDER_NAME} && npx playwright test --project=pac",
          "terminalId": "Test PAC",
          "autoExecute": true
        },
        {
          "action": "executeTerminalCommand",
          "command": "npx playwright show-report",
          "terminalId": "Test PAC",
          "autoExecute": false
        }
      ]
    },
    {
      "id": "demo-mqa3355a-dasl",
      "title": "3.3 - Test: MDA app",
      "moves": [
        {
          "action": "executeTerminalCommand",
          "command": "cd {TEST_SETUP_FOLDER_NAME} && npx playwright test --project=model-driven",
          "terminalId": "Test MDA"
        },
        {
          "action": "executeTerminalCommand",
          "command": "npx playwright show-report",
          "terminalId": "Test MDA",
          "autoExecute": false
        }
      ]
    },
    {
      "id": "demo-mqa34tsn-23ao",
      "title": "3.4 - Test: Canvas app",
      "description": "👉 for the sake of this demo, the implementation of canvas.fixtures.ts contains a ConcreteCanvasAppPage (containing «special» methods)",
      "moves": [
        {
          "action": "open",
          "path": "{TEST_SETUP_FOLDER_NAME}/fixtures/canvas.fixtures.ts"
        },
        {
          "action": "executeTerminalCommand",
          "command": "cd {TEST_SETUP_FOLDER_NAME} && npx playwright test --project=canvas",
          "terminalId": "Test Canvas",
          "autoExecute": true
        },
        {
          "action": "executeTerminalCommand",
          "command": "npx playwright show-report",
          "terminalId": "Test Canvas",
          "autoExecute": false
        }
      ]
    }
  ]
}